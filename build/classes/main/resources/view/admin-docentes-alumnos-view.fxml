<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.AdminDocentesAlumnosController"
      spacing="16" styleClass="admin-root"
      stylesheets="@/main/resources/css/admin-view.css">

    <VBox spacing="8" prefWidth="320">
        <Label text="Profesores" styleClass="subtitulo" />
        <TableView fx:id="tablaDocentes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDocenteNombre" text="Nombre" prefWidth="150" />
                <TableColumn fx:id="colDocenteApellido" text="Apellido" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label fx:id="lblTituloAlumnos" styleClass="subtitulo" />
        <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAlumnoNombre" text="Nombre" prefWidth="160" />
                <TableColumn fx:id="colAlumnoApellido" text="Apellido" prefWidth="160" />
                <TableColumn fx:id="colAlumnoSeccion" text="Curso / Sección" prefWidth="200" />
            </columns>
        </TableView>
    </VBox>

    <padding><Insets top="4" right="4" bottom="4" left="4" /></padding>
</HBox>
