<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.AdminHorariosController"
      spacing="12" styleClass="admin-root"
      stylesheets="@/main/resources/css/admin-view.css">

    <VBox spacing="10" styleClass="form-panel">
        <Label text="Asignar curso, sección, materia y profesor a un horario (7:05 am - 12:05 pm)" styleClass="form-title" wrapText="true" />
        <HBox spacing="10">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Sección" styleClass="field-label" />
                <ComboBox fx:id="comboSeccion" maxWidth="Infinity" promptText="Curso / Sección" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Día" styleClass="field-label" />
                <ComboBox fx:id="comboDia" maxWidth="Infinity" promptText="Día" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Periodo" styleClass="field-label" />
                <ComboBox fx:id="comboPeriodo" maxWidth="Infinity" promptText="Periodo" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Materia" styleClass="field-label" />
                <ComboBox fx:id="comboMateria" maxWidth="Infinity" promptText="Materia" />
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Profesor" styleClass="field-label" />
                <ComboBox fx:id="comboDocente" maxWidth="Infinity" promptText="Profesor" />
            </VBox>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="Asignar" styleClass="btn-primary" onAction="#handleAsignar" />
            <Button text="Eliminar asignación seleccionada" styleClass="btn-danger" onAction="#handleEliminar" />
            <Label fx:id="lblMensaje" wrapText="true" />
        </HBox>
    </VBox>

    <Label text="Horario general por sección" styleClass="subtitulo" />
    <TableView fx:id="tablaHorarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSeccion" text="Sección" prefWidth="150" />
            <TableColumn fx:id="colDia" text="Día" prefWidth="100" />
            <TableColumn fx:id="colHora" text="Horario" prefWidth="150" />
            <TableColumn fx:id="colMateria" text="Materia" prefWidth="170" />
            <TableColumn fx:id="colDocente" text="Profesor" prefWidth="170" />
        </columns>
    </TableView>

    <padding><Insets top="4" right="4" bottom="4" left="4" /></padding>
</VBox>
