<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" prefHeight="760.0" prefWidth="1200.0" stylesheets="@InformacionEstudiante.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Barra superior -->
            <HBox alignment="CENTER_LEFT" prefHeight="58.0" styleClass="top-bar">
                <children>
                    <Label styleClass="top-icon" text="🎓" />
                    <Label styleClass="top-title" text="Información del Estudiante" />
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                        <children>
                            <Button styleClass="window-button" text="—" />
                            <Button styleClass="window-close" text="×" />
                        </children>
                    </HBox>
                </children>
            </HBox>

            <HBox VBox.vgrow="ALWAYS">
                <children>

                    <!-- Menú lateral -->
                    <VBox prefHeight="668.0" prefWidth="154.0" spacing="18.0" styleClass="sidebar">
                        <children>
                            <Button maxWidth="1.7976931348623157E308" styleClass="menu-button-active" text="⌂   Inicio" />
                            <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="▣   Cursos" />
                            <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="♟   Profesores" />
                            <Button maxWidth="1.7976931348623157E308" prefHeight="17.0" prefWidth="172.0" styleClass="menu-button" text="⚙   Configuración" />

                            <VBox prefHeight="399.0" prefWidth="155.0" VBox.vgrow="ALWAYS" />
                            <Label styleClass="book-icon" text="📖" />
                        </children>
                    </VBox>

                    <!-- Contenido -->
                    <VBox spacing="18.0" styleClass="content" VBox.vgrow="ALWAYS">
                        <children>

                            <HBox prefHeight="145.0" styleClass="banner">
                                <children>
                                    <Label styleClass="banner-cap" text="🎓" />
                                    <VBox alignment="CENTER_LEFT" spacing="0.0">
                                        <children>
                                            <Label styleClass="banner-big" />
                                        </children>
                                    </VBox>
                                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" />
                                </children>
                            </HBox>

                            <!-- Datos vacíos: se llenan desde la base de datos -->
                            <HBox spacing="25.0" styleClass="student-card">
                                <children>

                                    <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <HBox spacing="15.0">
                                                <children>
                                                    <Label styleClass="field-label" text="👤  Nombre:" />
                                                    <TextField fx:id="txtNombre" editable="false" promptText="Nombre del estudiante" styleClass="data-field" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                            <HBox spacing="15.0">
                                                <children>
                                                    <Label styleClass="field-label" text="🎓  Grado:" />
                                                    <TextField fx:id="txtGrado" editable="false" promptText="Grado" styleClass="data-field" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <HBox spacing="15.0">
                                                <children>
                                                    <Label styleClass="field-label" text="👥  Sección:" />
                                                    <TextField fx:id="txtSeccion" editable="false" promptText="Sección" styleClass="data-field" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                            <HBox spacing="15.0">
                                                <children>
                                                    <Label styleClass="field-label" text="▣  Carnet:" />
                                                    <TextField fx:id="txtCarnet" editable="false" promptText="Carnet" styleClass="data-field" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- Cursos -->
                            <VBox spacing="12.0" styleClass="courses-card" VBox.vgrow="ALWAYS">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <children>
                                            <Label styleClass="section-icon" text="▣" />
                                            <Label styleClass="section-title" text="Mis Cursos y Profesores" HBox.hgrow="ALWAYS" />
                                            <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="🔍  Buscar curso..." styleClass="search-field" />
                                        </children>
                                    </HBox>

                                    <TableView fx:id="tablaCursos" styleClass="student-table" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colCurso" prefWidth="270.0" text="▣  Curso" />
                                            <TableColumn fx:id="colGrado" prefWidth="180.0" text="🎓  Grado" />
                                            <TableColumn fx:id="colSeccion" prefWidth="180.0" text="👥  Sección" />
                                            <TableColumn fx:id="colProfesor" prefWidth="300.0" text="👤  Profesor" />
                                        </columns>
                                        <placeholder>
                                            <Label styleClass="empty-label" text="No hay datos disponibles" />
                                        </placeholder>
                                    </TableView>
                                </children>
                            </VBox>

                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- Pie -->
            <HBox alignment="CENTER_LEFT" prefHeight="62.0" styleClass="footer">
                <children>
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCerrar" styleClass="close-button" text="✕  Cerrar" />
                </children>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
